# deploy/studyroom-pod.yaml 을 systemd 사용자 서비스로 올리는 Quadlet 유닛.
#
# 설치(리눅스 서버, rootless):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/quadlet/studyroom.kube deploy/studyroom-pod.yaml ~/.config/containers/systemd/
#   systemctl --user daemon-reload      # Quadlet generator가 studyroom.service를 만든다
#   systemctl --user start studyroom
#
# 주의:
# - 생성된 서비스는 "systemctl --user enable" 대상이 아니다. 부팅 시 자동 시작은 아래 [Install]을
#   generator가 읽어서 처리한다. 로그아웃 후에도 유지하려면 loginctl enable-linger $USER.
# - 이미지 localhost/study-room-api:dev 는 이 서비스를 실행하는 사용자의 이미지 저장소에 있어야 한다.
# - 생성 결과 미리보기: /usr/libexec/podman/quadlet -dryrun -user
[Unit]
Description=Study room API (MySQL + Spring Boot pod)
# 사용자 세션의 systemd는 시스템 network-online.target을 직접 기다리지 못한다.
# 최근 Podman의 Quadlet은 rootless 유닛에 podman-user-wait-network-online.service 의존성을
# 자동으로 붙인다고 알려져 있다 — 미확인. dryrun 출력의 [Unit] After=/Wants= 줄로 확인할 것.
After=network-online.target

[Kube]
# 유닛 파일 기준 상대 경로 — 같은 디렉터리에 studyroom-pod.yaml을 둔다.
Yaml=studyroom-pod.yaml

[Install]
WantedBy=default.target
